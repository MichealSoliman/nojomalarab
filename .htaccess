# =====================================================
# .htaccess - شركة نجوم العرب لنقل الأثاث بجدة
# =====================================================

Options -Indexes

RewriteEngine On
RewriteBase /

# ==========================================
# 1. إجبار بروتوكول HTTPS
# ==========================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ==========================================
# 2. إجبار النطاق بدون www (non-www)
# ==========================================
RewriteCond %{HTTP_HOST} ^www\.nojomalarab\.com$ [NC]
RewriteRule ^(.*)$ https://nojomalarab.com/$1 [R=301,L]

# ==========================================
# 3. إزالة index.html من نهاية الروابط
# example.com/about/index.html -> example.com/about/
# ==========================================
RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
RewriteRule ^(.+/)?index\.html$ https://nojomalarab.com/$1 [R=301,L]

# ==========================================
# 4. إضافة Trailing Slash للمجلدات والمسارات بدون امتداد ملف
# example.com/about -> example.com/about/
# ==========================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !index\.html
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+)$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://nojomalarab.com/$1/ [R=301,L]

# ==========================================
# 5. عمليات إعادة التوجيه 301 المحددة
# ==========================================
# معالجة افتراس الكلمة المفتاحية لمقال المدونة وتوجيهه لصفحة الخدمة المستهدفة
Redirect 301 /blogs/the-best-furniture-moving-company-in-jeddah/ https://nojomalarab.com/best-furniture-moving-company-jeddah/
Redirect 301 "/furniture-moving-across-jeddah's-neighborhoods-and-districts/" https://nojomalarab.com/furniture-moving-across-jeddahs-neighborhoods-and-districts/

# ==========================================
# 6. تشغيل index.html تلقائياً داخل أي مجلد
# ==========================================
DirectoryIndex index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# ==========================================
# 7. ضغط الملفات (Gzip / DEFLATE)
# ==========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==========================================
# 8. التخزين المؤقت للمتصفح (Browser Cache)
# ==========================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML
    ExpiresByType text/html "access plus 1 hour"

    # CSS & JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ==========================================
# 9. حماية الملفات الحساسة
# ==========================================
<FilesMatch "^(\.htaccess|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# ==========================================
# 10. صفحة الخطأ المخصصة 404
# ==========================================
ErrorDocument 404 /404.html
